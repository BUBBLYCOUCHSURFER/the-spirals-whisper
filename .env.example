# Cardbound Chronicles — environment template.
# Copy to .env and fill in your own values. NEVER commit a filled-in .env
# (or .env.local) — env files with real keys do not belong in git.
# Placeholder values below are not real keys.

NODE_ENV=development
PORT=3000
HOST=localhost

# MongoDB — local dev default. For hosted, use your Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/cardbound-chronicles

# Auth — generate a long random string; never reuse a placeholder.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d

# Stripe — from your Stripe dashboard (test keys start pk_test_ / sk_test_).
# The shop builds Checkout prices inline, so no Stripe Price IDs are needed.
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

STRIPE_CURRENCY=usd
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancel

# Gumroad (used by the Next.js unlock flow in src/) — from your Gumroad
# account: app.gumroad.com/settings/licenses and your product URL.
GUMROAD_LICENSE_KEY=your_gumroad_license_key_here
GUMROAD_PRODUCT_ID=your_gumroad_product_id_here
GUMROAD_USERNAME=your_gumroad_username_here

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Rate limiting for /api/*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
