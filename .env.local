# Gumroad License Key (get this from https://app.gumroad.com/settings/licenses)
GUMROAD_LICENSE_KEY=YOUR_LICENSE_KEY_HERE

# Gumroad Product ID (find in your product URL: https://gumroad.com/products/XXXXXX)
GUMROAD_PRODUCT_ID=your_product_id_here

# Your Gumroad username
GUMROAD_USERNAME=your_username
